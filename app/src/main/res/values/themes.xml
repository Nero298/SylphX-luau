<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SylPhXLuau" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Preset/engine selector card. Selected = filled mint with glow stroke +
         checkmark icon. Unselected = flat surface with subtle border. Sized
         like a small selectable card, not a thin pill, so it reads clearly
         on a phone screen. -->
    <style name="Widget.SylPhX.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_selector_bg</item>
        <item name="chipStrokeColor">@color/chip_selector_stroke</item>
        <item name="chipStrokeWidth">1.6dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">46dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="android:textColor">@color/chip_selector_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="checkedIcon">@drawable/ic_chip_check</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">@color/accent_cyan</item>
        <item name="rippleColor">@color/ripple_cyan</item>
    </style>
</resources>
