<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Engine selector: single line "engines || <current>". Tapping the
         current engine name opens a popup menu to switch engines. Only
         shown on Obfuscate/Deobfuscate. -->
    <LinearLayout
        android:id="@+id/engineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/engine_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="engines ||"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/engineSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="moonsec"
            android:textColor="@color/accent_cyan"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="v"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Detect-only button, shown only on Obfuscate tab -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/detectButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/detect_btn_bg"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="18dp"
        android:text="[?] Detect Type"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- INPUT + OUTPUT stacked vertically, both visible at once, sharing
         the remaining screen space evenly. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- INPUT PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="&lt;in&gt; input"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearInputButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/toolbar_btn_bg"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="[x] Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickFileButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/toolbar_btn_bg"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="[^] Upload File"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/url_input_bg"
                android:hint="#: Paste raw code URL, press Enter…"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/inputPanelFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/panel_bg"
                android:padding="1dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadeScrollbars="false"
                    android:scrollbars="vertical">

                    <EditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:hint=""
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minHeight="90dp"
                        android:padding="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="11.5sp" />

                </ScrollView>

                <TextView
                    android:id="@+id/pickedFileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/floating_chip_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text=""
                    android:textColor="@color/accent_cyan"
                    android:textSize="9.5sp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- OUTPUT PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="&lt;out&gt; output"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearOutputButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/toolbar_btn_bg"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="[x] Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/toolbar_btn_bg"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="[::] Copy"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/toolbar_btn_bg_accent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="[v] Download"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/outputPanelFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_bg"
                android:padding="1dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadeScrollbars="false"
                    android:scrollbars="vertical">

                    <EditText
                        android:id="@+id/resultOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:hint="-- Result will appear here..."
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minHeight="90dp"
                        android:padding="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textIsSelectable="true"
                        android:textSize="11.5sp" />

                </ScrollView>

                <LinearLayout
                    android:id="@+id/outputLoadingSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_panel"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal"
                        android:weightSum="1">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.80" android:background="@drawable/skeleton_bar" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.20" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal"
                        android:weightSum="1">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.60" android:background="@drawable/skeleton_bar" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.40" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:orientation="horizontal"
                        android:weightSum="1">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.90" android:background="@drawable/skeleton_bar" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.10" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/outputSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/floating_chip_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text=""
                    android:textColor="@color/accent_lime"
                    android:textSize="9.5sp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom status/run bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:textColor="@color/accent_lime"
            android:textSize="11.5sp" />

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="44dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/run_btn_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="&gt; Run"
                android:textAllCaps="false"
                android:textColor="@color/bg_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/bg_dark"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
