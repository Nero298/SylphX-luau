<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Animated theme background (behind everything) -->
    <com.sylphx.luau.AnimatedThemeView
        android:id="@+id/animatedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/customBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim" />

    <!-- Fixed landscape shell: sidebar (left) + main content (right). No page-level scrolling. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Sidebar -->
        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@color/sidebar_bg"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:elevation="4dp">

            <!-- Logo mascot -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/accent_cyan_dim"
                app:cardBackgroundColor="@color/icon_bg">

                <ImageView
                    android:id="@+id/sidebarMascot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logo_mascot_round"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="36dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider" />

            <FrameLayout
                android:id="@+id/tabDetect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sidebar_item_bg">

                <View
                    android:id="@+id/glowDetect"
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/sidebar_glow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:id="@+id/iconDetect"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_tab_detect"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelDetect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Detect"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabDeobfuscate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sidebar_item_bg">

                <View
                    android:id="@+id/glowDeobfuscate"
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/sidebar_glow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:id="@+id/iconDeobfuscate"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_tab_deobfuscate"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelDeobfuscate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Deobf"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabObfuscate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sidebar_item_bg">

                <View
                    android:id="@+id/glowObfuscate"
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/sidebar_glow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:id="@+id/iconObfuscate"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_tab_obfuscate"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelObfuscate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Obf"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabBeautify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sidebar_item_bg">

                <View
                    android:id="@+id/glowBeautify"
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/sidebar_glow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:id="@+id/iconBeautify"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_tab_beautify"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelBeautify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Beauty"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/tabSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/sidebar_item_bg">

                <View
                    android:id="@+id/glowSettings"
                    android:layout_width="3dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/sidebar_glow_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:id="@+id/iconSettings"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_tab_settings"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Settings"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Main content column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top header: wordmark logo at true aspect ratio (no more tiny squished logo) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_wordmark"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/currentTabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detect"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Fragment container: fixed, no outer scrolling -->
            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
