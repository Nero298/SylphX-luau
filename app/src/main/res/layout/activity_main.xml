<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Animated theme background (behind everything) -->
    <com.sylphx.luau.AnimatedThemeView
        android:id="@+id/animatedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/customBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim" />

    <!-- Mobile-first vertical shell: header on top, scrollable content in the
         middle, bottom navigation bar replaces the old desktop-style sidebar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: big wordmark logo as the hero element, no more tiny icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            android:elevation="3dp">

            <ImageView
                android:layout_width="125dp"
                android:layout_height="72dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/logo_wordmark"
                android:contentDescription="@null" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/currentTabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detect"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Fragment container: fills all remaining vertical space above the nav bar -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom navigation bar: 5 destinations, mobile-native pattern -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_nav_bg"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/tabDetect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bottom_nav_item_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iconDetect"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tab_detect"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelDetect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Detect"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabDeobfuscate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bottom_nav_item_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iconDeobfuscate"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tab_deobfuscate"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelDeobfuscate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Deobf"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabObfuscate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bottom_nav_item_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iconObfuscate"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tab_obfuscate"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelObfuscate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Obf"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabBeautify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bottom_nav_item_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iconBeautify"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tab_beautify"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelBeautify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Beauty"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bottom_nav_item_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iconSettings"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tab_settings"
                        app:tint="@color/sidebar_icon_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/labelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cài đặt"
                        android:textColor="@color/sidebar_label_tint"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
