<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/bg_panel"
                android:endColor="@color/blue_800" />
            <corners android:radius="14dp" />
            <stroke android:width="1.6dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/bg_panel"
                android:endColor="@color/blue_900" />
            <corners android:radius="14dp" />
            <stroke android:width="1.1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
