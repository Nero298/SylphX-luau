<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="10dp" />
            <stroke android:width="1.4dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="@color/accent_cyan_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/surface_raised"
                android:endColor="@color/surface" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="@color/blue_500" />
        </shape>
    </item>
</selector>
