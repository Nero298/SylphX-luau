<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_cyan_dim" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="@color/cyan_100" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/cyan_300"
                android:endColor="@color/cyan_600" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="@color/cyan_200" />
        </shape>
    </item>
</selector>
